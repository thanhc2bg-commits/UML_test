<div class="login-shell fade-in">
    <section class="login-intro" aria-label="Giới thiệu">
        <div class="brand-mark" aria-hidden="true">U</div>
        <p class="eyebrow">NỀN TẢNG HỌC UML</p>
        <h1>Học đúng trọng tâm,<br><span>tiến bộ mỗi ngày.</span></h1>
        <p class="login-intro__text">Ôn luyện Use Case, sơ đồ tuần tự và sơ đồ lớp theo cách trực quan, dễ nhớ.</p>
        <div class="login-dots" aria-hidden="true"><span></span><span></span><span></span></div>
    </section>
    <section class="login-card" aria-labelledby="login-title">
        <div class="login-card__header">
            <p class="eyebrow">CHÀO MỪNG TRỞ LẠI</p>
            <h2 id="login-title">Đăng nhập</h2>
            <p>Nhập thông tin để tiếp tục học tập.</p>
        </div>
        <div id="login-error" class="error-msg" role="alert" aria-live="polite" hidden></div>
        <form id="form-login">
            <div class="form-group">
                <label for="email">Email</label>
                <input type="email" id="email" autocomplete="email" placeholder="you@example.com" required>
            </div>
            <div class="form-group">
                <label for="password">Mật khẩu</label>
                <input type="password" id="password" autocomplete="current-password" placeholder="Nhập mật khẩu" required>
            </div>
            <button type="submit" id="btn-login">Đăng nhập <span aria-hidden="true">→</span></button>
        </form>
        <p class="login-card__footer">Cùng xây nền tảng UML vững chắc.</p>
    </section>
</div>
